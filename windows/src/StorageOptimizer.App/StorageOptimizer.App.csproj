<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the app compile on Linux and macOS too (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>StorageOptimizer</AssemblyName>
    <RootNamespace>StorageOptimizer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Storage Optimizer</AssemblyTitle>
    <!-- Made from Packaging/AppIcon.png by scripts/make_icons.py. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StorageOptimizer.Core\StorageOptimizer.Core.csproj" />
  </ItemGroup>

</Project>
