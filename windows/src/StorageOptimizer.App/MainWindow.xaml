<Window x:Class="StorageOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StorageOptimizer.App.ViewModels"
        xmlns:views="clr-namespace:StorageOptimizer.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Storage Optimizer" Icon="/Assets/AppIcon.ico"
        Width="1240" Height="820" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}">
            <views:LargeFilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FoldersViewModel}">
            <views:FoldersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileTypesViewModel}">
            <views:FileTypesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CacheCleanerViewModel}">
            <views:CacheCleanerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="8,16,4,12">
            <TextBlock DockPanel.Dock="Top" Text="Storage Optimizer" FontSize="16" FontWeight="SemiBold"
                       Margin="14,0,8,16" TextTrimming="CharacterEllipsis" />
            <ListBox x:Name="Navigation" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Pages">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="2,6">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,14,20,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ScanTargets}" SelectedItem="{Binding SelectedScanTarget}"
                              DisplayMemberPath="Title" Width="250" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToEnabled}}"
                              AutomationProperties.Name="What to scan" />
                    <Button Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0" ToolTip="Choose a folder to scan"
                            AutomationProperties.Name="Choose folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Choose folder…" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ScanCommand}" Margin="8,0,0,0" MinWidth="110"
                            Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" Margin="8,0,0,0" MinWidth="110"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding SelectedPage.Title}" FontSize="26" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="20,0,20,8">
                <DockPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="4" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding SelectedPage}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
