<UserControl x:Class="StorageOptimizer.App.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StorageOptimizer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FileListViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="Files">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowInExplorerCommand}"
                              CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" />
                <KeyBinding Key="Delete" Command="{Binding MoveToRecycleBinCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show in File Explorer"
                              Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Open"
                              Command="{Binding PlacementTarget.DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Copy path"
                              Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Move to Recycle Bin…"
                              Command="{Binding PlacementTarget.DataContext.MoveToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="160" SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:FileRow}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding CategoryBrush}"
                                           FontSize="13" Margin="2,0,8,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" SortDirection="Descending" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" MinWidth="140" />
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=d, TargetNullValue=—}" SortMemberPath="Modified" Width="100" />
                <DataGridTextColumn Header="Last opened" Binding="{Binding Accessed, StringFormat=d, TargetNullValue=—}" SortMemberPath="Accessed" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Show in File Explorer" Command="{Binding ShowInExplorerCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" />
                <Button Content="Move to Recycle Bin…" Margin="8,0,0,0" Command="{Binding MoveToRecycleBinCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</UserControl>
