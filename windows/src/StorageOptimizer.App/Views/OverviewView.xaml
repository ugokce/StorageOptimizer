<UserControl x:Class="StorageOptimizer.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StorageOptimizer.App.ViewModels"
             xmlns:infra="clr-namespace:StorageOptimizer.App.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,4,20,16">

            <!-- Drive usage -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding DriveTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding UsedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <Border Height="22" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource ControlAltFillColorQuarternaryBrush}">
                        <ItemsControl ItemsSource="{Binding Segments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <infra:ProportionalPanel Total="{Binding DataContext.DriveTotal, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="infra:ProportionalPanel.Weight" Value="{Binding Weight}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UsageSegment}">
                                    <Rectangle Fill="{Binding Brush}" ToolTip="{Binding ToolTip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Segments}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UsageSegment}">
                                <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsNearlyFull, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="This drive is almost full. Check Large Files and the Cache Cleaner, then empty the Recycle Bin to get space back."
                                   Style="{StaticResource WrappingSecondaryText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Caches and last scan -->
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="Reclaimable caches" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CacheCleaner.RecommendedSizeText}" Style="{StaticResource BigNumber}" />
                            <ProgressBar IsIndeterminate="True" Width="40" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding CacheCleaner.IsMeasuring, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="Temporary files, browser and developer caches that apps recreate when needed."
                                   Style="{StaticResource WrappingSecondaryText}" Margin="0,4,0,12" />
                        <Button Content="Open Cache Cleaner" HorizontalAlignment="Left"
                                Command="{Binding GoToCommand}" CommandParameter="{Binding CacheCleaner}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Last scan" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Main.StatusText}" Style="{StaticResource WrappingSecondaryText}" Margin="0,0,0,12" />
                        <Button Content="Scan now" HorizontalAlignment="Left" Command="{Binding Main.ScanCommand}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Shown before the first scan -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Margin="0,16" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="No scan yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick your user folder, a drive or any folder at the top, then choose Scan."
                               Style="{StaticResource WrappingSecondaryText}" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Space by file type -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Space by file type" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="6"
                                                 Foreground="{Binding Brush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Largest items and files -->
            <UniformGrid Columns="2" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{Binding TopItemsTitle}" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding TopItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderRow}">
                                    <Button Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent"
                                            BorderThickness="0" Padding="4,4" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="4"
                                                             Foreground="{Binding BarBrush}" Margin="0,4,0,0" IsHitTestVisible="False" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Browse folders" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding GoToCommand}" CommandParameter="{Binding Main.FolderBrowser}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Largest files" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding TopFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileRow}">
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding CategoryBrush}" FontSize="14" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Margin="8,0,0,0" Padding="6,2" ToolTip="Show in File Explorer"
                                                AutomationProperties.Name="Show in File Explorer"
                                                Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Show all large files" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding GoToCommand}" CommandParameter="{Binding Main.LargeFiles}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
