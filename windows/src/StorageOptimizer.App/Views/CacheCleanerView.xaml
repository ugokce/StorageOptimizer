<UserControl x:Class="StorageOptimizer.App.Views.CacheCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StorageOptimizer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CacheCleanerViewModel}">
    <Grid Margin="20,4,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Explanation and selection buttons -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Caches are recreated automatically when apps and tools need them. Cleaning deletes them permanently, so the space is freed right away; items marked &quot;Review first&quot; may hold something you want to keep."
                       Style="{StaticResource WrappingSecondaryText}" MaxHeight="60" Margin="0,0,0,10" />
            <WrapPanel>
                <Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,6" />
                <Button Content="Deselect all" Command="{Binding DeselectAllCommand}" Margin="0,0,8,6" />
                <Button Command="{Binding RefreshCommand}" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh sizes" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>

        <!-- Administrator items -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10"
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RestartAsAdministratorCommand}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Restart as administrator" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Some Windows caches (Windows Update, system temporary files) can only be cleaned as administrator."
                           Style="{StaticResource WrappingSecondaryText}" VerticalAlignment="Center" MaxHeight="40" />
            </DockPanel>
        </Border>

        <!-- Apps that should be closed -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,10"
                    Visibility="{Binding RunningAppsWarning, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="14" Margin="0,0,8,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Text="{Binding RunningAppsWarning}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Targets -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Looking for caches…" Style="{StaticResource SecondaryText}" Margin="0,8"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CacheGroupViewModel}">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="2,6,0,4" />
                                <TextBlock Text="Found by the last scan. Delete these only for projects you're not working on right now."
                                           Style="{StaticResource WrappingSecondaryText}" Margin="2,0,0,6"
                                           Visibility="{Binding IsProjects, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CacheRowViewModel}">
                                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top"
                                                              Margin="0,2,10,0" AutomationProperties.Name="{Binding Title}" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <Border Style="{StaticResource Badge}" Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                                                <TextBlock Text="{Binding Badge}" FontSize="11" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource WrappingSecondaryText}" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding LocationsText}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"
                                                                   ToolTip="{Binding LocationsText}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center"
                                                            ToolTip="Open in File Explorer" AutomationProperties.Name="Open in File Explorer"
                                                            Command="{Binding OpenFolderCommand}">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No cache folders were found." Style="{StaticResource SecondaryText}" Margin="0,8"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Command="{Binding CleanCommand}" MinWidth="140">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Clean selected…" />
                </StackPanel>
            </Button>
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,12,0"
                         Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
